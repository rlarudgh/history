---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ui/ProjectCard.astro';
import Layout from '../layouts/Layout.astro';

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => a.data.order - b.data.order);

const allCategories = [...new Set(sortedProjects.map((p) => p.data.category))];
---

<Layout
  title="프로젝트 | 포트폴리오"
  description="주요 프로젝트 목록입니다."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="mb-12" data-aos="fade-up">
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-slate-50 mb-4">
        프로젝트
      </h1>
      <p class="text-slate-600 dark:text-slate-400">
        지금까지 참여한 프로젝트들을 소개합니다.
      </p>
    </div>

    <div class="flex flex-wrap gap-2 mb-10" data-aos="fade-up">
      <button
        class="filter-btn active px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-medium transition-colors"
        data-filter="all"
      >
        전체
      </button>
      {
        allCategories.map((cat) => (
          <button
            class="filter-btn px-4 py-2 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-400 rounded-lg text-sm font-medium border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors"
            data-filter={cat}
          >
            {cat}
          </button>
        ))
      }
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" id="project-grid">
      {
        sortedProjects.map((project, index) => (
          <div
            class="project-item h-full"
            data-category={project.data.category}
            data-aos="fade-up"
            data-aos-delay={index * 100}
          >
            <ProjectCard
              title={project.data.title}
              shortDesc={project.data.shortDesc}
              company={project.data.company}
              role={project.data.role}
              category={project.data.category}
              techStack={project.data.techStack}
              hashtags={project.data.hashtags}
              coverImage={project.data.coverImage}
              slug={project.id}
            />
          </div>
        ))
      }
    </div>
  </div>
</Layout>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const projectItems = document.querySelectorAll('.project-item');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      filterBtns.forEach((b) => {
        b.classList.remove('bg-blue-600', 'text-white');
        b.classList.add('bg-white', 'text-slate-600', 'dark:bg-slate-800', 'dark:text-slate-400');
      });
      btn.classList.remove('bg-white', 'text-slate-600', 'dark:bg-slate-800', 'dark:text-slate-400');
      btn.classList.add('bg-blue-600', 'text-white');

      projectItems.forEach((item) => {
        const category = item.getAttribute('data-category') || '';
        if (filter === 'all' || category === filter) {
          (item as HTMLElement).style.display = 'block';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
