---
import { getCollection, render } from 'astro:content';
import ProjectCard from '../../components/ui/ProjectCard.astro';
import Tag from '../../components/ui/Tag.astro';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const sorted = projects.sort((a, b) => a.data.order - b.data.order);

  return sorted.map((project, index) => {
    const prev = sorted[index - 1] ?? null;
    const next = sorted[index + 1] ?? null;
    const related = sorted
      .filter((p) => p.id !== project.id && p.data.category === project.data.category)
      .slice(0, 3);
    return {
      params: { slug: project.id },
      props: { project, prev, next, related },
    };
  });
}

const { project, prev, next, related } = Astro.props;
const { Content } = await render(project);
---

<Layout
  title={`${project.data.title} | 프로젝트`}
  description={project.data.shortDesc}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="mb-8" data-aos="fade-up">
      <div class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 mb-4">
        <span>{project.data.company}</span>
        <span>|</span>
        <span>{project.data.role}</span>
        <span>|</span>
        <span
          >{project.data.startDate}{
            project.data.endDate
              ? ` - ${project.data.endDate}`
              : ' - 현재'
          }</span
        >
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-slate-50 mb-4">
        {project.data.title}
      </h1>
      <div class="flex flex-wrap gap-2 mb-6">
        {project.data.hashtags.map((tag) => (
          <Tag label={`#${tag}`} variant="primary" />
        ))}
      </div>
      <p class="text-lg text-slate-600 dark:text-slate-400">{project.data.shortDesc}</p>
    </div>

    <div
      class="aspect-video bg-slate-100 dark:bg-slate-800 rounded-xl overflow-hidden mb-12"
      data-aos="fade-up"
      transition:name={`project-image-${project.id}`}
    >
      {
        project.data.coverImage ? (
          <img
            src={project.data.coverImage}
            alt={project.data.title}
            class="w-full h-full object-cover"
          />
        ) : (
          <div class="w-full h-full bg-gradient-to-br from-slate-500 to-slate-700 flex flex-col items-center justify-center relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-white/10 rounded-full -translate-y-1/2 translate-x-1/2"></div>
            <div class="absolute bottom-0 left-0 w-24 h-24 bg-white/10 rounded-full translate-y-1/2 -translate-x-1/2"></div>
            <span class="relative z-10 text-5xl font-bold text-white/80">{project.data.title.slice(0, 2)}</span>
          </div>
        )
      }
    </div>

    <div class="grid md:grid-cols-3 gap-8 mb-12" data-aos="fade-up">
      <div>
        <h3
          class="text-sm font-semibold text-slate-900 dark:text-slate-100 uppercase tracking-wider mb-3"
        >
          기술 스택
        </h3>
        <div class="flex flex-wrap gap-2">
          {project.data.techStack.map((tech) => (
            <Tag label={tech} variant="outline" />
          ))}
        </div>
      </div>
      <div class="md:col-span-2">
        <h3
          class="text-sm font-semibold text-slate-900 dark:text-slate-100 uppercase tracking-wider mb-3"
        >
          주요 기능
        </h3>
        <ul class="space-y-2">
          {project.data.features.map((feature) => (
            <li class="flex items-start gap-2 text-slate-600 dark:text-slate-400">
              <svg
                class="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
                />
              </svg>
              <span>{feature}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {
      project.data.screenshots && project.data.screenshots.length > 0 && (
        <section class="mb-12" data-aos="fade-up">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-50 mb-6">스크린샷</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" id="screenshot-gallery">
            {project.data.screenshots.map((src, i) => (
              <button
                class="group relative aspect-video bg-slate-100 dark:bg-slate-800 rounded-xl overflow-hidden cursor-zoom-in border-0"
                data-screenshot-index={i}
              >
                <img
                  src={src}
                  alt={`${project.data.title} 스크린샷 ${i + 1}`}
                  class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors" />
                <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                  <svg class="w-8 h-8 text-white drop-shadow-lg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                  </svg>
                </div>
              </button>
            ))}
          </div>
        </section>
      )
    }

    <div class="prose prose-slate dark:prose-invert max-w-none mb-12" data-aos="fade-up">
      <Content />
    </div>

    {
      project.data.learnings.length > 0 && (
        <div class="bg-slate-50 dark:bg-slate-800 rounded-xl p-6 mb-12 transition-colors duration-300" data-aos="fade-up">
          <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100 mb-4">배운 점</h3>
          <ul class="space-y-2">
            {project.data.learnings.map((learning) => (
              <li class="flex items-start gap-2 text-slate-600 dark:text-slate-400">
                <svg
                  class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
                  />
                </svg>
                <span>{learning}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      project.data.links && project.data.links.length > 0 && (
        <div class="flex flex-wrap gap-4 mb-12" data-aos="fade-up">
          {project.data.links.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors"
            >
              {link.label}
              <svg
                class="w-4 h-4 ml-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                />
              </svg>
            </a>
          ))}
        </div>
      )
    }

    {/* Prev / Next Navigation */}
    <div class="flex flex-col sm:flex-row gap-4 pt-8 border-t border-slate-200 dark:border-slate-700">
      {
        prev ? (
          <a
            href={`/projects/${prev.id}`}
            class="flex-1 group p-4 bg-slate-50 dark:bg-slate-800 rounded-xl border border-slate-100 dark:border-slate-700 hover:border-blue-300 dark:hover:border-blue-700 transition-all"
          >
            <span class="text-xs text-slate-500 dark:text-slate-400 mb-1 block">이전 프로젝트</span>
            <span class="text-lg font-semibold text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-1">
              {prev.data.title}
            </span>
          </a>
        ) : (
          <div class="flex-1" />
        )
      }
      {
        next ? (
          <a
            href={`/projects/${next.id}`}
            class="flex-1 group p-4 bg-slate-50 dark:bg-slate-800 rounded-xl border border-slate-100 dark:border-slate-700 hover:border-blue-300 dark:hover:border-blue-700 transition-all text-right"
          >
            <span class="text-xs text-slate-500 dark:text-slate-400 mb-1 block">다음 프로젝트</span>
            <span class="text-lg font-semibold text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-1">
              {next.data.title}
            </span>
          </a>
        ) : (
          <div class="flex-1" />
        )
      }
    </div>

    {/* Related Projects */}
    {
      related.length > 0 && (
        <section class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-700" data-aos="fade-up">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-50 mb-6">관련 프로젝트</h2>
          <div class="grid md:grid-cols-3 gap-6">
            {related.map((p) => (
              <ProjectCard
                title={p.data.title}
                shortDesc={p.data.shortDesc}
                company={p.data.company}
                role={p.data.role}
                category={p.data.category}
                techStack={p.data.techStack}
                hashtags={p.data.hashtags}
                coverImage={p.data.coverImage}
                slug={p.id}
              />
            ))}
          </div>
        </section>
      )
    }
  </div>

  {/* Lightbox */}
  <div
    id="lightbox"
    class="fixed inset-0 z-[80] bg-black/90 hidden items-center justify-center p-4"
  >
    <button
      id="lightbox-close"
      class="absolute top-4 right-4 p-2 text-white/80 hover:text-white z-10"
      aria-label="닫기"
    >
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"
        />
      </svg>
    </button>
    <button
      id="lightbox-prev"
      class="absolute left-4 top-1/2 -translate-y-1/2 p-2 text-white/80 hover:text-white z-10 hidden"
      aria-label="이전"
    >
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 19l-7-7 7-7"
        />
      </svg>
    </button>
    <button
      id="lightbox-next"
      class="absolute right-4 top-1/2 -translate-y-1/2 p-2 text-white/80 hover:text-white z-10 hidden"
      aria-label="다음"
    >
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5l7 7-7 7"
        />
      </svg>
    </button>
    <img id="lightbox-img" src="" alt="" class="max-w-full max-h-full object-contain rounded-lg" />
  </div>

  <script is:inline>
    (function () {
      const gallery = document.getElementById('screenshot-gallery');
      const lightbox = document.getElementById('lightbox');
      const lightboxImg = document.getElementById('lightbox-img');
      const closeBtn = document.getElementById('lightbox-close');
      const prevBtn = document.getElementById('lightbox-prev');
      const nextBtn = document.getElementById('lightbox-next');

      if (!gallery || !lightbox || !lightboxImg) return;

      const buttons = gallery.querySelectorAll('button[data-screenshot-index]');
      const images = Array.from(buttons).map((btn) => {
        const img = btn.querySelector('img');
        return img ? img.src : '';
      });

      let currentIndex = 0;

      function open(index) {
        if (images.length === 0) return;
        currentIndex = index;
        lightboxImg.src = images[currentIndex];
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
        document.body.style.overflow = 'hidden';
        updateNav();
      }

      function close() {
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
        document.body.style.overflow = '';
      }

      function updateNav() {
        if (images.length > 1) {
          prevBtn?.classList.remove('hidden');
          nextBtn?.classList.remove('hidden');
        } else {
          prevBtn?.classList.add('hidden');
          nextBtn?.classList.add('hidden');
        }
      }

      function next() {
        currentIndex = (currentIndex + 1) % images.length;
        lightboxImg.src = images[currentIndex];
      }

      function prev() {
        currentIndex = (currentIndex - 1 + images.length) % images.length;
        lightboxImg.src = images[currentIndex];
      }

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const index = Number(btn.getAttribute('data-screenshot-index'));
          open(index);
        });
      });

      closeBtn?.addEventListener('click', close);
      lightbox?.addEventListener('click', (e) => {
        if (e.target === lightbox) close();
      });
      prevBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        prev();
      });
      nextBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        next();
      });

      document.addEventListener('keydown', (e) => {
        if (lightbox.classList.contains('hidden')) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowRight') next();
        if (e.key === 'ArrowLeft') prev();
      });
    })();
  </script>
</Layout>
