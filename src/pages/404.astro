---
import Layout from '../layouts/Layout.astro';
---

<Layout title="페이지를 찾을 수 없습니다 | 포트폴리오" description="요청하신 페이지를 찾을 수 없습니다.">
  <section class="py-16">
    <p class="font-mono text-xs tracking-widest uppercase text-slate-500 dark:text-slate-400">Error / 404</p>
    <h1 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-50">
      페이지를 찾을 수 없습니다
    </h1>
    <p class="mt-4 text-slate-600 dark:text-slate-400">
      주소가 바뀌었거나 삭제된 페이지입니다.
    </p>
    <pre class="mt-8 p-5 overflow-x-auto font-mono text-sm leading-relaxed text-slate-300 bg-slate-900 rounded-lg border border-slate-800"><span class="text-blue-400">$</span> cd {Astro.url.pathname}
cd: no such file or directory</pre>
    <div class="flex flex-wrap gap-3 mt-8">
      <a
        href="/"
        class="px-4 py-2 text-sm font-medium text-white dark:text-slate-900 bg-slate-900 dark:bg-slate-50 rounded-md hover:bg-slate-700 dark:hover:bg-slate-200 transition-colors"
      >
        홈으로
      </a>
      <a
        href="/projects"
        class="px-4 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 rounded-md hover:border-slate-500 transition-colors"
      >
        프로젝트 보기
      </a>
    </div>
  </section>
</Layout>
