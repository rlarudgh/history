---
import Layout from '../layouts/Layout.astro';
---

<Layout title="페이지를 찾을 수 없습니다 | 포트폴리오" description="요청하신 페이지를 찾을 수 없습니다.">
  <div class="min-h-[70vh] flex items-center justify-center px-4">
    <div class="text-center" data-aos="fade-up">
      <div class="mb-6">
        <span class="text-8xl font-bold text-slate-200 dark:text-slate-700 select-none">404</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-slate-50 mb-4">
        페이지를 찾을 수 없습니다
      </h1>
      <p class="text-slate-600 dark:text-slate-400 mb-8 max-w-md mx-auto">
        요청하신 페이지가 삭제되었거나 주소가 변경되었을 수 있습니다. 아래 링크를 통해 원하는 페이지로 이동해 보세요.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a
          href="/"
          class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors"
        >
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          홈으로
        </a>
        <a
          href="/projects"
          class="inline-flex items-center px-6 py-3 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors"
        >
          프로젝트 보기
        </a>
      </div>
    </div>
  </div>
</Layout>
