---
export const prerender = false;

import { env } from 'cloudflare:workers';
import { marked } from 'marked';
import Tag from '../../components/ui/Tag.astro';
import Layout from '../../layouts/Layout.astro';
import { getHolologConfig, getPost, isHolologConfigured } from '../../lib/hololog';

const { slug } = Astro.params;

// Astro v6 + Cloudflare: 런타임 바인딩은 cloudflare:workers 의 env 로 읽는다
const config = getHolologConfig(env as unknown as Record<string, string | undefined>);

let post: Awaited<ReturnType<typeof getPost>> = null;
if (slug && isHolologConfigured(config)) {
  try {
    post = await getPost(slug, config);
  } catch (error) {
    console.error(`[blog] 글(${slug})을 불러오지 못했습니다.`, error);
  }
}

if (!post) {
  Astro.response.status = 404;
}

// 신뢰된 자체 백엔드(Hololog API)의 Markdown 본문을 HTML로 렌더링
const contentHtml = post ? await marked.parse(post.content) : '';
---

{
  post ? (
    <Layout title={`${post.title} | 블로그`} description={post.description}>
      <article>
        <header class="mb-10 pb-8 border-b border-slate-200 dark:border-slate-800">
          <div class="mb-4">
            <span class="font-mono text-xs text-slate-500 dark:text-slate-400">
              {new Date(post.date).toLocaleDateString('ko-KR')}
            </span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-50 mb-4">
            {post.title}
          </h1>
          <p class="text-lg text-slate-600 dark:text-slate-400">{post.description}</p>
          <div class="flex flex-wrap gap-2 mt-4">
            {post.tags.map((tag) => (
              <Tag label={`#${tag}`} variant="outline" />
            ))}
          </div>
        </header>

        <div class="prose prose-slate dark:prose-invert max-w-none" set:html={contentHtml} />

        <div class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-800">
          <a
            href="/blog"
            class="inline-flex items-center font-mono text-xs text-slate-500 dark:text-slate-400 hover:text-accent transition-colors"
          >
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 19l-7-7m0 0l7-7m-7 7h18"
              />
            </svg>
            목록으로 돌아가기
          </a>
        </div>
      </article>
    </Layout>
  ) : (
    <Layout title="글을 찾을 수 없습니다 | 블로그" description="요청한 글이 없습니다.">
      <div class="py-24">
        <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-50 mb-4">
          글을 찾을 수 없습니다
        </h1>
        <p class="text-slate-600 dark:text-slate-400 mb-8">
          요청하신 글이 없거나 아직 발행되지 않았습니다.
        </p>
        <a
          href="/blog"
          class="inline-flex items-center font-mono text-xs text-slate-500 dark:text-slate-400 hover:text-accent transition-colors"
        >
          블로그 목록으로 돌아가기
        </a>
      </div>
    </Layout>
  )
}
