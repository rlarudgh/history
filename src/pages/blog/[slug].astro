---
import { getCollection, render } from 'astro:content';
import Tag from '../../components/ui/Tag.astro';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={`${post.data.title} | 블로그`}
  description={post.data.description}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="mb-8" data-aos="fade-up">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span
          class="text-xs font-medium px-2.5 py-0.5 rounded-full bg-blue-50 dark:bg-blue-900/20 text-blue-700 dark:text-blue-400"
        >
          {post.data.category}
        </span>
        <span class="text-xs text-slate-500 dark:text-slate-400">
          {new Date(post.data.pubDate).toLocaleDateString('ko-KR')}
        </span>
        {
          post.data.updatedDate && (
            <span class="text-xs text-slate-500 dark:text-slate-400">
              (수정: {new Date(post.data.updatedDate).toLocaleDateString('ko-KR')})
            </span>
          )
        }
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-slate-50 mb-4">
        {post.data.title}
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400">
        {post.data.description}
      </p>
      <div class="flex flex-wrap gap-2 mt-4">
        {post.data.tags.map((tag) => (
          <Tag label={`#${tag}`} variant="primary" />
        ))}
      </div>
    </div>

    {
      post.data.coverImage && (
        <div
          class="aspect-video bg-slate-100 dark:bg-slate-800 rounded-xl overflow-hidden mb-12"
          data-aos="fade-up"
        >
          <img
            src={post.data.coverImage}
            alt={post.data.title}
            class="w-full h-full object-cover"
          />
        </div>
      )
    }

    <div class="prose prose-slate dark:prose-invert max-w-none" data-aos="fade-up">
      <Content />
    </div>

    <div
      class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-700"
      data-aos="fade-up"
    >
      <a
        href="/blog"
        class="inline-flex items-center text-sm font-medium text-blue-600 dark:text-blue-400 hover:underline"
      >
        <svg
          class="w-4 h-4 mr-1"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"
          />
        </svg>
        목록으로 돌아가기
      </a>
    </div>
  </div>
</Layout>
