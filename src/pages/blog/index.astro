---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---

<Layout
  title="블로그 | 포트폴리오"
  description="기술과 개발에 관한 이야기를 기록합니다."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="mb-12" data-aos="fade-up">
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-slate-50 mb-4">
        블로그
      </h1>
      <p class="text-slate-600 dark:text-slate-400">
        기술과 개발에 관한 이야기를 기록합니다.
      </p>
    </div>

    <div class="space-y-8">
      {
        posts.map((post, index) => (
          <article class="group" data-aos="fade-up" data-aos-delay={index * 100}>
            <a
              href={`/blog/${post.id}`}
              class="block p-6 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-blue-300 dark:hover:border-blue-700 hover:shadow-md transition-all"
            >
              <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class="text-xs font-medium px-2.5 py-0.5 rounded-full bg-blue-50 dark:bg-blue-900/20 text-blue-700 dark:text-blue-400">
                  {post.data.category}
                </span>
                <span class="text-xs text-slate-500 dark:text-slate-400">
                  {new Date(post.data.pubDate).toLocaleDateString('ko-KR')}
                </span>
              </div>
              <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100 mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                {post.data.title}
              </h2>
              <p class="text-slate-600 dark:text-slate-400 text-sm mb-3">
                {post.data.description}
              </p>
              <div class="flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <span class="text-xs text-slate-500 dark:text-slate-400">
                    #{tag}
                  </span>
                ))}
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</Layout>
