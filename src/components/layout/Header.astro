---
import { isActivePath, navLinks } from '../../data/navigation';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header
  class="lg:hidden sticky top-0 z-40 bg-white dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800"
>
  <div class="flex items-center justify-between h-14 px-4 sm:px-6">
    <a
      href="/"
      class="font-mono text-sm font-semibold text-slate-900 dark:text-slate-50 hover:text-accent transition-colors"
    >
      kkh.dev
    </a>

    {/* ThemeToggle은 Layout에서 이 자리(우측, 메뉴 버튼 왼쪽)에 고정 배치됨 */}
    <button
      id="mobile-menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="메뉴 열기"
      class="p-2 -mr-2 text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-50"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-slate-200 dark:border-slate-800" aria-label="모바일 메뉴">
    <ul class="px-4 sm:px-6 py-3">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActivePath(link, pathname) ? 'page' : undefined}
              class="flex items-center justify-between py-2.5 text-sm text-slate-600 dark:text-slate-400 aria-[current]:text-slate-900 dark:aria-[current]:text-slate-50 aria-[current]:font-semibold"
            >
              {link.label}
              <span class="font-mono text-xs text-slate-400" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  function initMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu || btn.dataset.bound) return;
    btn.dataset.bound = 'true';

    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
    };

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(menu.classList.contains('hidden'));
    });

    // 앵커 이동 시 메뉴 닫기
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('click', (e) => {
      if (!menu.contains(e.target as Node) && !btn.contains(e.target as Node)) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }

  document.addEventListener('astro:page-load', initMobileMenu);
</script>
