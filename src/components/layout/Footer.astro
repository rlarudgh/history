---
import { profile } from '../../data/profile';
import { getVisitorCount } from '../../scripts/theme';

const visitorCount = getVisitorCount();
const currentYear = new Date().getFullYear();
---

<footer
  class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mt-24 py-8 border-t border-slate-200 dark:border-slate-800 font-mono text-xs text-slate-500 dark:text-slate-400"
>
  <p>&copy; {currentYear} {profile.name}. Built with Astro.</p>
  <p>방문자 {visitorCount}</p>
</footer>
