---
import { getCollection } from 'astro:content';
import ProjectRow from '../ui/ProjectRow.astro';
import SectionHeader from '../ui/SectionHeader.astro';

const FEATURED_COUNT = 5;

const all = await getCollection('projects');
const featured = all.sort((a, b) => a.data.order - b.data.order).slice(0, FEATURED_COUNT);
---

<section id="projects" aria-labelledby="projects-heading" class="pt-24" data-aos="fade-up">
  <SectionHeader label="04 / Projects" title="프로젝트" id="projects-heading" />

  <div class="border-t border-slate-200 dark:border-slate-800">
    {
      featured.map((project, index) => (
        <ProjectRow
          index={index}
          title={project.data.title}
          shortDesc={project.data.shortDesc}
          company={project.data.company}
          category={project.data.category}
          startDate={project.data.startDate}
          techStack={project.data.techStack}
          hashtags={project.data.hashtags}
          coverImage={project.data.coverImage}
          slug={project.id}
        />
      ))
    }
  </div>

  <a
    href="/projects"
    class="group inline-flex items-center gap-2 mt-8 text-sm font-medium text-slate-900 dark:text-slate-50 hover:text-accent transition-colors"
  >
    전체 프로젝트 {all.length}개 보기
    <span class="group-hover:translate-x-1 transition-transform" aria-hidden="true">→</span>
  </a>
</section>
