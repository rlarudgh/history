---
import { caseStudy, REPO_URL, workflowSteps } from '../../data/workflow';
import SectionHeader from '../ui/SectionHeader.astro';

/*
 * 저장소의 실제 설정 파일을 빌드 시점에 읽어 근거로 보여준다.
 * (import.meta.glob은 번들 시점에 해석되므로 배포 런타임과 무관하게 동작)
 */
const ruleFiles = import.meta.glob<string>('/.claude/rules/*.md', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const commandFiles = import.meta.glob<string>('/.claude/commands/*', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const specFiles = import.meta.glob<string>('/e2e/*.spec.ts', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const huskyFiles = import.meta.glob<string>('/.husky/{pre-commit,commit-msg}', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const ciFiles = import.meta.glob<string>('/.github/workflows/ci.yml', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const protectScripts = import.meta.glob<string>('/.claude/scripts/protect-files.sh', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const fileName = (path: string) => path.split('/').pop() ?? path;

const rules = Object.keys(ruleFiles).map((path) => ({
  name: fileName(path),
  href: `${REPO_URL}/blob/main${path}`,
}));

const commands = Object.keys(commandFiles).map((path) => `/${fileName(path)}`);

const testTitles = Object.values(specFiles).flatMap((source) =>
  [...source.matchAll(/^\s*test\(\s*'([^']+)'/gm)].map((match) => match[1])
);

// protect-files.sh 의 PROTECTED=( ... ) 배열에서 보호 패턴 추출
const protectSource = Object.values(protectScripts)[0] ?? '';
const protectedPatterns = [
  ...(protectSource.match(/PROTECTED=\(([\s\S]*?)\)/)?.[1] ?? '').matchAll(/"([^"]+)"/g),
].map((match) => match[1]);

const hooks = [
  ...(protectedPatterns.length > 0
    ? [
        {
          name: '.claude/settings.json → PreToolUse(Edit|Write)',
          command: `protect-files.sh  # 차단: ${protectedPatterns.join(' ')}`,
        },
      ]
    : []),
  ...Object.entries(huskyFiles).map(([path, source]) => ({
    name: `.husky/${fileName(path)}`,
    command: source.trim(),
  })),
];

const ciSource = Object.values(ciFiles)[0] ?? '';
const ciJobs = [...ciSource.matchAll(/^\s{4}name:\s*(.+)$/gm)].map((match) => match[1].trim());

const stats = [
  { label: '에이전트 규칙', value: rules.length, unit: '개' },
  { label: '커스텀 명령', value: commands.length, unit: '개' },
  { label: 'E2E 시나리오', value: testTitles.length, unit: '개' },
  { label: 'CI 단계', value: ciJobs.length, unit: '단계' },
];
---

<section id="workflow" aria-labelledby="workflow-heading" class="pt-24" data-aos="fade-up">
  <SectionHeader label="05 / Workflow" title="AI와 일하는 방식" id="workflow-heading">
    <p class="mt-4 text-slate-600 dark:text-slate-400">
      구현은 AI에게 맡기되, 결과는 규칙과 자동 검증으로 통제합니다. 아래 숫자와 코드는 이 사이트 저장소의 실제
      파일에서 빌드 시점에 읽어 온 것입니다.
    </p>
  </SectionHeader>

  <dl
    class="grid grid-cols-2 sm:grid-cols-4 border-y border-slate-200 dark:border-slate-800 divide-x divide-slate-200 dark:divide-slate-800"
  >
    {
      stats.map((stat) => (
        <div class="py-5 px-4 first:pl-0">
          <dt class="font-mono text-xs text-slate-500 dark:text-slate-400">{stat.label}</dt>
          <dd class="mt-1 text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-50">
            {stat.value}
            <span class="text-sm font-medium text-slate-500 dark:text-slate-400">{stat.unit}</span>
          </dd>
        </div>
      ))
    }
  </dl>

  <ol class="mt-10 border-t border-slate-200 dark:border-slate-800">
    {
      workflowSteps.map((step, index) => (
        <li class="grid sm:grid-cols-[10.5rem_1fr] gap-x-6 gap-y-2 py-6 border-b border-slate-200 dark:border-slate-800">
          <p class="font-mono text-xs leading-7 tracking-widest uppercase text-slate-500 dark:text-slate-400">
            {String(index + 1).padStart(2, '0')} {step.label}
          </p>
          <div class="min-w-0">
            <h3 class="text-lg font-semibold tracking-tight text-slate-900 dark:text-slate-50">{step.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{step.description}</p>

            {step.key === 'rules' && (
              <ul class="flex flex-wrap gap-2 mt-4">
                {rules.map((rule) => (
                  <li>
                    <a
                      href={rule.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-block px-2 py-0.5 font-mono text-xs text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-800 rounded-md hover:text-accent hover:border-slate-400 dark:hover:border-slate-600 transition-colors"
                    >
                      {rule.name}
                    </a>
                  </li>
                ))}
                {commands.map((command) => (
                  <li class="px-2 py-0.5 font-mono text-xs text-slate-500 bg-slate-100 dark:bg-slate-900 rounded-md">
                    {command}
                  </li>
                ))}
              </ul>
            )}

            {step.key === 'guardrails' && (
              <div class="mt-4 p-4 space-y-3 overflow-x-auto font-mono text-xs leading-relaxed bg-slate-900 rounded-md border border-slate-800">
                {hooks.map((hook) => (
                  <div>
                    <p class="text-slate-500"># {hook.name}</p>
                    <code class="block whitespace-pre text-slate-300">{hook.command}</code>
                  </div>
                ))}
              </div>
            )}

            {step.key === 'verify' && (
              <div class="mt-4">
                <p class="font-mono text-xs text-slate-500 dark:text-slate-400">
                  CI: {ciJobs.join(' → ')}
                </p>
                <ul class="mt-3 space-y-1 font-mono text-xs text-slate-600 dark:text-slate-400">
                  {testTitles.slice(0, 5).map((title) => (
                    <li>
                      <span class="text-slate-400 dark:text-slate-600">✓</span> {title}
                    </li>
                  ))}
                  {testTitles.length > 5 && (
                    <li class="text-slate-400 dark:text-slate-600">… 외 {testTitles.length - 5}개</li>
                  )}
                </ul>
              </div>
            )}
          </div>
        </li>
      ))
    }
  </ol>

  <article class="mt-12 p-6 sm:p-8 rounded-lg border border-slate-200 dark:border-slate-800">
    <p class="font-mono text-xs tracking-widest uppercase text-slate-500 dark:text-slate-400">Case</p>
    <h3 class="mt-2 text-xl font-bold tracking-tight text-slate-900 dark:text-slate-50">{caseStudy.title}</h3>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{caseStudy.summary}</p>
    <ol class="mt-6 space-y-3">
      {
        caseStudy.events.map((event) => (
          <li class="grid grid-cols-[4rem_1fr] gap-x-4 text-sm">
            <span class="font-mono text-xs leading-6 text-slate-500 dark:text-slate-400">{event.tag}</span>
            <span class="leading-6 text-slate-700 dark:text-slate-300">{event.text}</span>
          </li>
        ))
      }
    </ol>
  </article>
</section>
