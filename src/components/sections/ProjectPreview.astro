---
import { getCollection } from 'astro:content';
import ProjectCard from '../ui/ProjectCard.astro';

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => a.data.order - b.data.order).slice(0, 3);
---

<section class="py-20 md:py-28 bg-slate-50 dark:bg-slate-900 transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-12" data-aos="fade-up">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-slate-50 mb-2">
          프로젝트
        </h2>
        <p class="text-slate-600 dark:text-slate-400">주요 프로젝트들을 소개합니다</p>
      </div>
      <a
        href="/projects"
        class="hidden md:inline-flex items-center text-blue-600 dark:text-blue-400 font-medium hover:text-blue-700 dark:hover:text-blue-300 transition-colors"
      >
        전체 보기
        <svg
          class="w-4 h-4 ml-2"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 8l4 4m0 0l-4 4m4-4H3"
          />
        </svg>
      </a>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        sortedProjects.map((project, index) => (
          <div data-aos="fade-up" data-aos-delay={index * 100}>
            <ProjectCard
              title={project.data.title}
              shortDesc={project.data.shortDesc}
              company={project.data.company}
              role={project.data.role}
              category={project.data.category}
              techStack={project.data.techStack}
              hashtags={project.data.hashtags}
              coverImage={project.data.coverImage}
              slug={project.id}
            />
          </div>
        ))
      }
    </div>

    <div class="mt-10 text-center md:hidden">
      <a
        href="/projects"
        class="inline-flex items-center px-6 py-3 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium rounded-lg border border-slate-300 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors"
      >
        전체 프로젝트 보기
      </a>
    </div>
  </div>
</section>
