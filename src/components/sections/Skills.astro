---
import { skills } from '../../data/skills';
import SectionHeader from '../ui/SectionHeader.astro';
import TechBadge from '../ui/TechBadge.astro';
---

<section id="skills" aria-labelledby="skills-heading" class="pt-24" data-aos="fade-up">
  <SectionHeader label="03 / Skills" title="기술 스택" id="skills-heading" />

  <dl class="border-t border-slate-200 dark:border-slate-800">
    {
      skills.map((group) => (
        <div class="skill-group grid sm:grid-cols-[10.5rem_1fr] gap-x-6 gap-y-3 py-6 border-b border-slate-200 dark:border-slate-800">
          <dt class="font-mono text-xs leading-7 tracking-wide text-slate-500 dark:text-slate-400">
            {group.category}
          </dt>
          <dd>
            <ul class="flex flex-wrap gap-x-5 gap-y-2.5">
              {group.items.map((skill) => (
                <li class="flex items-center gap-2 text-sm font-medium text-slate-800 dark:text-slate-200">
                  <TechBadge name={skill.name} iconOnly />
                  {skill.name}
                </li>
              ))}
            </ul>
          </dd>
        </div>
      ))
    }
  </dl>
</section>
