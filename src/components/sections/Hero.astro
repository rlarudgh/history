---
import { profile } from '../../data/profile';

interface Props {
  name?: string;
  role?: string;
  tagline?: string;
  skills?: string[];
}

const {
  name = profile.name,
  role = profile.role,
  tagline = profile.introductions[0],
  skills = ['React', 'TypeScript', 'Next.js', 'Node.js', 'TailwindCSS'],
} = Astro.props;

const terminalLines = [
  { cmd: 'whoami', output: name },
  { cmd: 'cat role.txt', output: role },
  { cmd: 'cat about.txt', output: tagline },
  { cmd: 'ls skills/', output: skills.join('  ') },
];
---

<section id="intro" aria-labelledby="intro-heading">
  <p class="font-mono text-xs tracking-widest uppercase text-slate-500 dark:text-slate-400">
    {profile.field} · {profile.careerYears}년차
  </p>
  <h1
    id="intro-heading"
    class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-50"
  >
    {profile.name}<span class="text-slate-400 dark:text-slate-600">,</span>
    <span class="block sm:inline text-slate-500 dark:text-slate-400 font-semibold">{profile.role}</span>
  </h1>

  <div class="mt-8 overflow-hidden bg-slate-900 rounded-lg border border-slate-800">
    <div class="flex items-center justify-between px-4 py-2.5 border-b border-slate-800">
      <div class="flex items-center gap-1.5" aria-hidden="true">
        <span class="w-2.5 h-2.5 rounded-full bg-slate-700"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-slate-700"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-slate-700"></span>
      </div>
      <span class="font-mono text-xs text-slate-500">~/kkh.dev — zsh</span>
      <span class="w-10" aria-hidden="true"></span>
    </div>

    <div class="min-h-[320px] sm:min-h-[340px] p-5 sm:p-7 font-mono text-sm leading-relaxed">
      <div id="terminal-output" class="space-y-1"></div>
      <div id="terminal-prompt" class="hidden mt-2">
        <span class="text-blue-400">$</span>
        <span class="ml-2 text-slate-200" id="typing-text"></span>
        <span class="inline-block w-2 h-4 ml-1 align-middle bg-slate-300 animate-pulse" id="cursor"></span>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ terminalLines }}>
  (function () {
    const outputEl = document.getElementById('terminal-output');
    const promptEl = document.getElementById('terminal-prompt');
    const typingTextEl = document.getElementById('typing-text');
    const cursorEl = document.getElementById('cursor');

    if (!outputEl || !promptEl || !typingTextEl || !cursorEl) return;

    const TYPE_SPEED = 50;
    const LINE_DELAY = 250;
    const OUTPUT_DELAY = 350;

    function sleep(ms) {
      return new Promise((resolve) => setTimeout(resolve, ms));
    }

    async function typeText(element, text, speed = TYPE_SPEED) {
      let current = '';
      for (let i = 0; i < text.length; i++) {
        current += text[i];
        element.textContent = current;
        await sleep(speed);
      }
    }

    function createPromptLine() {
      const line = document.createElement('div');
      line.className = 'flex flex-wrap items-start gap-x-2';
      line.innerHTML = `
        <span class="text-blue-400 shrink-0">$</span>
        <span class="typing-command text-slate-200"></span>
      `;
      return line;
    }

    function createOutputLine(text) {
      const line = document.createElement('div');
      line.className = 'text-slate-400 pl-0 md:pl-4 mb-3 leading-relaxed';
      line.textContent = text;
      return line;
    }

    let isRunning = false;

    async function runTerminal() {
      if (isRunning) return;
      isRunning = true;

      // Reset output for view transitions
      outputEl.innerHTML = '';
      promptEl.classList.add('hidden');
      typingTextEl.textContent = '';

      await sleep(500);

      for (const line of terminalLines) {
        promptEl.classList.remove('hidden');
        typingTextEl.textContent = '';
        await sleep(200);

        await typeText(typingTextEl, line.cmd);
        await sleep(LINE_DELAY);

        // Move typed command to output and hide input line (like pressing Enter)
        const promptLine = createPromptLine();
        const cmdSpan = promptLine.querySelector('.typing-command');
        cmdSpan.textContent = line.cmd;
        outputEl.appendChild(promptLine);
        promptEl.classList.add('hidden');

        await sleep(OUTPUT_DELAY);

        const outputLine = createOutputLine(line.output);
        outputEl.appendChild(outputLine);
        await sleep(400);
      }

      promptEl.classList.remove('hidden');
      typingTextEl.textContent = '';
      isRunning = false;
    }

    // Run after every page load (including initial load & view transitions)
    document.addEventListener('astro:page-load', runTerminal);
  })();
</script>
