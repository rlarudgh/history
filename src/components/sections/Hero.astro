---
import { profile } from '../../data/profile';
import Terminal from '../ui/Terminal.astro';
---

<section id="intro" aria-labelledby="intro-heading">
  <p class="font-mono text-xs tracking-widest uppercase text-slate-500 dark:text-slate-400">
    {profile.field} · {profile.careerYears}년차
  </p>
  <h1
    id="intro-heading"
    class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-50"
  >
    {profile.name}<span class="text-slate-400 dark:text-slate-600">,</span>
    <span class="block sm:inline text-slate-500 dark:text-slate-400 font-semibold">{profile.role}</span>
  </h1>

  <Terminal class="mt-8" />
</section>
