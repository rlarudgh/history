---
interface Props {
  categories: string[];
  techStack: string[];
  hashtags: string[];
}

const { categories, techStack } = Astro.props;
---

<div class="space-y-6">
  <!-- 카테고리 필터 -->
  <div>
    <h2 class="mb-3 font-mono text-xs tracking-widest uppercase text-slate-500 dark:text-slate-400">
      카테고리
    </h2>
    <div class="flex flex-wrap gap-2" id="category-filters">
      <button
        class="filter-btn active"
        data-filter-type="category"
        data-filter-value="all"
        aria-pressed="false"
      >
        전체
      </button>
      {categories.map((cat) => (
        <button
          class="filter-btn"
          data-filter-type="category"
          data-filter-value={cat}
          aria-pressed="false"
        >
          {cat}
        </button>
      ))}
    </div>
  </div>

  <!-- 기술 스택 필터 -->
  <div>
    <h2 class="mb-3 font-mono text-xs tracking-widest uppercase text-slate-500 dark:text-slate-400">
      기술 스택
    </h2>
    <div class="flex flex-wrap gap-2" id="techstack-filters">
      <button
        class="filter-btn active"
        data-filter-type="techstack"
        data-filter-value="all"
        aria-pressed="false"
      >
        전체
      </button>
      {techStack.slice(0, 12).map((tech) => (
        <button
          class="filter-btn"
          data-filter-type="techstack"
          data-filter-value={tech}
          aria-pressed="false"
        >
          {tech}
        </button>
      ))}
    </div>
  </div>
</div>

<style>
  .filter-btn {
    padding: 0.375rem 0.875rem;
    font-size: 0.875rem;
    border-radius: 0.375rem;
    border: 1px solid var(--color-slate-200);
    color: var(--color-slate-600);
    transition:
      color 150ms,
      border-color 150ms,
      background-color 150ms;
    cursor: pointer;
  }

  .filter-btn:hover {
    border-color: var(--color-slate-400);
    color: var(--color-slate-900);
  }

  .filter-btn.active,
  .filter-btn[aria-pressed="true"] {
    background-color: var(--color-slate-900);
    border-color: var(--color-slate-900);
    color: white;
  }

  :global(.dark) .filter-btn {
    border-color: var(--color-slate-800);
    color: var(--color-slate-400);
  }

  :global(.dark) .filter-btn:hover {
    border-color: var(--color-slate-600);
    color: var(--color-slate-50);
  }

  :global(.dark) .filter-btn.active,
  :global(.dark) .filter-btn[aria-pressed="true"] {
    background-color: var(--color-slate-50);
    border-color: var(--color-slate-50);
    color: var(--color-slate-900);
  }
</style>

<script>
  // 필터 버튼 클릭 이벤트 처리
  const categoryFilters = document.getElementById('category-filters');
  const techstackFilters = document.getElementById('techstack-filters');

  if (!categoryFilters || !techstackFilters) {
    // Early exit without return statement
  } else {
    let currentCategory = 'all';
    let currentTechStack = 'all';

    function setupFilters(container: HTMLElement, type: string) {
      const buttons = container.querySelectorAll('.filter-btn');

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const btnElement = button as HTMLElement;
          const value = btnElement.dataset.filterValue || 'all';

          // 활성 상태 업데이트
          buttons.forEach((b) => {
            (b as HTMLElement).classList.remove('active');
            b.setAttribute('aria-pressed', 'false');
          });
          btnElement.classList.add('active');
          btnElement.setAttribute('aria-pressed', 'true');

          // 필터 상태 업데이트
          if (type === 'category') {
            currentCategory = value;
          } else if (type === 'techstack') {
            currentTechStack = value;
          }

          // 필터 변경 이벤트 발송
          const filters: { type: string; value: string }[] = [];
          if (currentCategory !== 'all') {
            filters.push({ type: 'category', value: currentCategory });
          }
          if (currentTechStack !== 'all') {
            filters.push({ type: 'techstack', value: currentTechStack });
          }

          document.dispatchEvent(
            new CustomEvent('filter-change', {
              detail: { filters },
            }),
          );
        });
      });
    }

    setupFilters(categoryFilters, 'category');
    setupFilters(techstackFilters, 'techstack');
  }
</script>
