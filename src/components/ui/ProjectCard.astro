---
import Tag from './Tag.astro';

interface Props {
  title: string;
  shortDesc: string;
  company: string;
  role: string;
  category: string;
  techStack: string[];
  hashtags: string[];
  coverImage?: string;
  slug: string;
}

const { title, shortDesc, company, role, category, techStack, hashtags, coverImage, slug } =
  Astro.props;

// Category-based gradient backgrounds
const categoryStyles: Record<string, { gradient: string; icon: string }> = {
  웹: {
    gradient: 'from-blue-500 to-indigo-600',
    icon: '<svg class="w-12 h-12 text-white/80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>',
  },
  앱: {
    gradient: 'from-emerald-500 to-teal-600',
    icon: '<svg class="w-12 h-12 text-white/80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>',
  },
  AI: {
    gradient: 'from-purple-500 to-pink-600',
    icon: '<svg class="w-12 h-12 text-white/80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>',
  },
  서버: {
    gradient: 'from-orange-500 to-red-600',
    icon: '<svg class="w-12 h-12 text-white/80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>',
  },
};

const style = categoryStyles[category] || {
  gradient: 'from-slate-500 to-slate-700',
  icon: '<svg class="w-12 h-12 text-white/80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>',
};
---

<article
  class="group bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden hover:shadow-lg dark:hover:shadow-slate-900/50 transition-all duration-300"
>
  <a href={`/projects/${slug}`} class="block">
    <div class="aspect-video overflow-hidden" transition:name={`project-image-${slug}`}>
      {
        coverImage ? (
          <img
            src={coverImage}
            alt={title}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
        ) : (
          <div class={`w-full h-full bg-gradient-to-br ${style.gradient} flex flex-col items-center justify-center relative overflow-hidden`}>
            {/* Decorative circles */}
            <div class="absolute top-0 right-0 w-32 h-32 bg-white/10 rounded-full -translate-y-1/2 translate-x-1/2"></div>
            <div class="absolute bottom-0 left-0 w-24 h-24 bg-white/10 rounded-full translate-y-1/2 -translate-x-1/2"></div>
            
            {/* Icon */}
            <div class="relative z-10 mb-2" set:html={style.icon} />
            
            {/* Category label */}
            <span class="relative z-10 text-white/90 text-xs font-medium tracking-wider uppercase">{category}</span>
          </div>
        )
      }
    </div>
    <div class="p-5">
      <div class="flex items-center gap-2 mb-2">
        <span class="text-xs text-slate-500 dark:text-slate-400">{company}</span>
        <span class="text-xs text-slate-300 dark:text-slate-600">|</span>
        <span class="text-xs text-slate-500 dark:text-slate-400">{role}</span>
      </div>
      <h3
        class="text-lg font-bold text-slate-900 dark:text-slate-100 mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors"
      >
        {title}
      </h3>
      <p class="text-sm text-slate-600 dark:text-slate-400 mb-4 line-clamp-2">
        {shortDesc}
      </p>
      <div class="flex flex-wrap gap-2 mb-3">
        <span class="inline-block px-3 py-1 text-xs font-semibold rounded-full bg-blue-600 text-white">
          {category}
        </span>
      </div>
      <div class="flex flex-wrap gap-1.5">
        {techStack.slice(0, 4).map((tech) => (
          <Tag label={tech} variant="outline" />
        ))}
        {techStack.length > 4 && (
          <Tag label={`+${techStack.length - 4}`} variant="outline" />
        )}
      </div>
    </div>
  </a>
</article>
