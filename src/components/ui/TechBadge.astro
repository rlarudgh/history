---
import * as icons from 'simple-icons';

interface Props {
  name: string;
}

const { name } = Astro.props;

// Convert tech name to simple-icons slug
function toSlug(name: string): string {
  return name
    .toLowerCase()
    .replace(/\.js$/, 'dotjs') // Next.js → nextdotjs
    .replace(/\.css$/, 'css') // Tailwind CSS → tailwindcss
    .replace(/[^a-z0-9]/g, ''); // Remove special chars
}

function getIcon(name: string) {
  const slug = toSlug(name);
  const iconKey = `si${slug.charAt(0).toUpperCase()}${slug.slice(1)}`;
  return (icons as Record<string, { path: string; hex: string } | undefined>)[iconKey];
}

const icon = getIcon(name);
---

{
  icon ? (
    <div class="flex items-center gap-2 px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-600 rounded-lg hover:border-blue-300 dark:hover:border-blue-500 hover:shadow-sm transition-all group">
      <svg
        class="w-5 h-5"
        viewBox="0 0 24 24"
        fill="currentColor"
        style={`color: #${icon.hex}`}
      >
        <path d={icon.path} />
      </svg>
      <span class="text-sm font-medium text-slate-700 dark:text-slate-300 group-hover:text-slate-900 dark:group-hover:text-slate-100">
        {name}
      </span>
    </div>
  ) : (
    <div class="flex items-center gap-2 px-4 py-2.5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-600 rounded-lg hover:border-blue-300 dark:hover:border-blue-500 hover:shadow-sm transition-all group">
      <div class="w-5 h-5 rounded bg-slate-200 dark:bg-slate-700 flex items-center justify-center">
        <span class="text-xs font-bold text-slate-500 dark:text-slate-400">
          {name.charAt(0)}
        </span>
      </div>
      <span class="text-sm font-medium text-slate-700 dark:text-slate-300 group-hover:text-slate-900 dark:group-hover:text-slate-100">
        {name}
      </span>
    </div>
  )
}
