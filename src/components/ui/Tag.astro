---
interface Props {
  label: string;
  href?: string;
  variant?: 'default' | 'primary' | 'outline';
}

const { label, href, variant = 'default' } = Astro.props;

const variantClasses = {
  default: 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300',
  primary: 'bg-accent-soft text-accent',
  outline: 'border border-slate-200 text-slate-600 dark:border-slate-700 dark:text-slate-400',
};

const baseClasses = `inline-block px-2 py-0.5 text-xs font-medium rounded-md transition-colors ${variantClasses[variant]}`;
---

{
  href ? (
    <a href={href} class:list={[baseClasses, 'hover:text-accent']}>
      {label}
    </a>
  ) : (
    <span class={baseClasses}>{label}</span>
  )
}
