---
---

<label
  id="theme-toggle"
  class="relative inline-flex items-center cursor-pointer w-14 h-8 rounded-full bg-slate-200 dark:bg-slate-700 transition-colors duration-300"
  aria-label="테마 전환"
>
  <input type="checkbox" class="sr-only peer" id="theme-checkbox" />
  
  {/* Track background with icons */}
  <span class="absolute inset-0 flex items-center justify-between px-1.5 pointer-events-none">
    {/* Sun icon - left side */}
    <svg
      class="w-4 h-4 text-amber-500 opacity-100 dark:opacity-0 transition-opacity duration-300"
      fill="currentColor"
      viewBox="0 0 20 20"
    >
      <path
        fill-rule="evenodd"
        d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
        clip-rule="evenodd"
      />
    </svg>
    
    {/* Moon icon - right side */}
    <svg
      class="w-4 h-4 text-slate-400 opacity-0 dark:opacity-100 transition-opacity duration-300"
      fill="currentColor"
      viewBox="0 0 20 20"
    >
      <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
    </svg>
  </span>
  
  {/* Slider thumb */}
  <span
    class="absolute left-0.5 top-0.5 w-7 h-7 bg-white rounded-full shadow-md transform transition-transform duration-300 translate-x-0 dark:translate-x-6 flex items-center justify-center"
  >
    {/* Thumb icon - sun (light mode) */}
    <svg
      class="w-4 h-4 text-amber-500 dark:hidden"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
      />
    </svg>
    
    {/* Thumb icon - moon (dark mode) */}
    <svg
      class="w-4 h-4 text-indigo-600 hidden dark:block"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
      />
    </svg>
  </span>
</label>

<script>
  import { getCurrentTheme, applyTheme } from '../../scripts/theme';

  (function () {
    function getCheckbox(): HTMLInputElement | null {
      return document.getElementById('theme-checkbox') as HTMLInputElement | null;
    }

    function updateToggle() {
      const checkbox = getCheckbox();
      if (checkbox) {
        checkbox.checked = getCurrentTheme() === 'dark';
      }
    }

    function toggleTheme() {
      const currentTheme = getCurrentTheme();
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      applyTheme(newTheme);
      localStorage.setItem('theme', newTheme);
      updateToggle();
    }

    // Initial setup
    const checkbox = getCheckbox();
    checkbox?.addEventListener('change', toggleTheme);
    updateToggle();

    // Listen for theme application from Layout
    document.addEventListener('theme-applied', () => {
      const newCheckbox = getCheckbox();
      if (newCheckbox && !newCheckbox.dataset.listenerAttached) {
        newCheckbox.addEventListener('change', toggleTheme);
        newCheckbox.dataset.listenerAttached = 'true';
      }
      updateToggle();
    });
  })();
</script>
